generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  GUEST
  RESERVATIONS
  SALES
  ADMIN
  GM
  DEV
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  EXPIRED
  PAYMENT_REVIEW
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EnquirySource {
  WEBSITE
  EMAIL
  WHATSAPP
}

enum EnquiryCategory {
  UNCLASSIFIED
  ROOM_BOOKING
  WEDDING_EVENT
  CORPORATE_OFFSITE
  COMPLAINT
  GENERAL
}

enum EnquiryDepartment {
  UNSORTED
  RESERVATIONS
  SALES
  GM
}

enum EnquiryStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_GUEST
  RESOLVED
  CLOSED
}

enum EnquiryMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum EnquiryMessageSender {
  GUEST
  STAFF
  AI
  SYSTEM
}

enum ReplyDraftStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(GUEST)

  assignedEnquiries Enquiry[]              @relation("EnquiryAssignee")
  enquiryMessages   EnquiryMessage[]
  enquiryNotes      EnquiryNote[]
  approvedDrafts    EnquiryReplyDraft[]    @relation("DraftApprover")
  enquiryHistory    EnquiryStatusHistory[]
}

model Room {
  id         String  @id @default(uuid())
  roomNumber String  @unique
  isActive   Boolean @default(true)
  isRetired  Boolean @default(false)

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  assignments RoomAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomTypeId, isActive, isRetired])
}

model RoomType {
  id               String  @id @default(uuid())
  name             String  @unique
  shortDescription String?
  description      String?
  maxGuests        Int
  totalUnits       Int
  area             Int?
  bedConfiguration String?
  amenities        String[] @default([])
  images           String[] @default([])
  isActive         Boolean @default(true)

  bookingItems  BookingItem[]
  dailyRates    DailyRate[]
  allotments    WebsiteAllotment[]
  rooms         Room[]
  blackoutDates BlackoutDate[]
}

model RoomAssignment {
  id        String @id @default(uuid())
  bookingId String
  roomId    String

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())

  @@unique([bookingId, roomId])
  @@index([roomId])
  @@index([bookingId])
}

model Booking {
  id String @id @default(uuid())

  guestName  String
  guestEmail String
  guestPhone String

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  adults   Int
  children Int      @default(0)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  gstAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  status        BookingStatus @default(PENDING_PAYMENT)
  holdExpiresAt DateTime?

  items           BookingItem[]
  payments        Payment[]
  roomAssignments RoomAssignment[]

  promoCodeId    String?
  discountAmount Decimal    @default(0) @db.Decimal(12, 2)
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id])

  cancellationTokenHash String?  @unique
  createdAt             DateTime @default(now())

  enquiries Enquiry[]
}

model BookingItem {
  id String @id @default(uuid())

  bookingId  String
  roomTypeId String
  quantity   Int

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  gstAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)

  booking  Booking  @relation(fields: [bookingId], references: [id])
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
}

model RatePlan {
  id         String      @id @default(uuid())
  name       String      @unique
  dailyRates DailyRate[]
}

model DailyRate {
  id String @id @default(uuid())

  roomTypeId String
  ratePlanId String

  date    DateTime @db.Date
  price   Decimal  @db.Decimal(10, 2)
  gstRate Decimal  @db.Decimal(5, 2)

  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id])

  @@unique([roomTypeId, ratePlanId, date])
}

model WebsiteAllotment {
  id            String   @id @default(uuid())
  roomTypeId    String
  date          DateTime @db.Date
  allottedUnits Int

  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([roomTypeId, date])
}

model BlackoutDate {
  id         String    @id @default(uuid())
  date       DateTime  @db.Date
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id])

  @@unique([date, roomTypeId])
}

model PromoCode {
  id               String       @id @default(uuid())
  code             String       @unique
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)
  minBookingAmount Decimal      @default(0) @db.Decimal(12, 2)
  startsAt         DateTime
  expiresAt        DateTime
  maxUses          Int?
  usedCount        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())

  bookings Booking[]
}

model Enquiry {
  id         String  @id @default(uuid())
  guestName  String
  guestEmail String?
  guestPhone String?
  subject    String

  source     EnquirySource     @default(WEBSITE)
  category   EnquiryCategory   @default(UNCLASSIFIED)
  department EnquiryDepartment @default(UNSORTED)
  status     EnquiryStatus     @default(NEW)

  aiConfidence    Decimal? @db.Decimal(5, 4)
  aiSummary       String?
  aiExtractedData Json?

  assignedToId String?
  assignedTo   User?   @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  relatedBookingId String?
  relatedBooking   Booking? @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)

  eventType       String?
  eventDate       DateTime? @db.Date
  eventGuestCount Int?
  eventBudget     Decimal?  @db.Decimal(12, 2)

  externalThreadId String?
  lastMessageAt    DateTime?

  messages      EnquiryMessage[]
  notes         EnquiryNote[]
  replyDrafts   EnquiryReplyDraft[]
  statusHistory EnquiryStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department, status, createdAt])
  @@index([assignedToId, status])
  @@index([category, createdAt])
  @@index([guestEmail])
  @@index([externalThreadId])
}

model EnquiryMessage {
  id        String  @id @default(uuid())
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  senderType EnquiryMessageSender
  direction  EnquiryMessageDirection
  source     EnquirySource

  senderUserId String?
  senderUser   User?   @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  content           String
  externalMessageId String? @unique

  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}

model EnquiryNote {
  id        String  @id @default(uuid())
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  content   String
  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}

model EnquiryReplyDraft {
  id        String  @id @default(uuid())
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  content String
  status  ReplyDraftStatus @default(PENDING_REVIEW)

  approvedById String?
  approvedBy   User?   @relation("DraftApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([enquiryId, status])
}

model EnquiryStatusHistory {
  id        String  @id @default(uuid())
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  fromStatus     EnquiryStatus?
  toStatus       EnquiryStatus?
  fromDepartment EnquiryDepartment?
  toDepartment   EnquiryDepartment?
  note           String?

  createdAt DateTime @default(now())

  @@index([enquiryId, createdAt])
}

model GuestOtpChallenge {
  id         String    @id @default(uuid())
  identifier String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actorRole String
  action    String
  resource  String
  filters   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
